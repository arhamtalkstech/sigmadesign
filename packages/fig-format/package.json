{
  "name": "@alteron/fig-format",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./src/index.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsup src/index.ts --format esm --dts --clean",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "inspect": "tsx src/cli/inspect.ts"
  },
  "dependencies": {
    "fzstd": "^0.1.1",
    "jszip": "^3.10.1",
    "kiwi-schema": "^0.5.0",
    "pako": "^2.1.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/pako": "^2.0.3",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
